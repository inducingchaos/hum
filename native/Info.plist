<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Embedded into the humplayer binary (__TEXT,__info_plist) so macOS has a name
     and bundle id for it in Now Playing, without needing an .app bundle. -->
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key>
  <string>local.hum.humplayer</string>
  <key>CFBundleName</key>
  <string>hum</string>
  <key>CFBundleDisplayName</key>
  <string>hum</string>
  <key>CFBundleExecutable</key>
  <string>humplayer</string>
  <key>CFBundleVersion</key>
  <string>1</string>
  <key>CFBundleShortVersionString</key>
  <string>1.0</string>
  <key>LSUIElement</key>
  <true/>
</dict>
</plist>
